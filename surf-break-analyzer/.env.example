# Copy to .env (which is gitignored) and fill in. Never commit the real key.
ANTHROPIC_API_KEY=

# Optional overrides
# SURFBREAK_MODEL=claude-opus-5-5
# SURFBREAK_EFFORT=high          # low | medium | high | xhigh | max
# SURFBREAK_MAX_TOKENS=32000
# SURFBREAK_RESULT_TTL=2700      # seconds to reuse an identical result
# SURFBREAK_DATA_DIR=./data      # where predictions and session logs are saved
